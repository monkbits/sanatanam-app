# Keep all data models so Gson reflection works in Release builds
-keep class com.mymonkmindset.sanatanam.models.** { *; }
-keepclassmembers class com.mymonkmindset.sanatanam.models.** { *; }

# Keep Gson annotations and reflection attributes
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod
-keepclassmembers class * {
    @com.google.gson.annotations.SerializedName <fields>;
}
-keep class com.google.gson.** { *; }

# Keep Room classes
-keep class androidx.room.** { *; }
-dontwarn androidx.room.**

# Keep Glide classes
-keep class com.bumptech.glide.** { *; }

# Keep Material Design components
-keep class com.google.android.material.** { *; }

# Keep Shimmer
-keep class com.facebook.shimmer.** { *; }
