<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingActivity">
    <!--   page title -->
    <include
        android:id="@+id/cm_page_title_include"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/cm_page_title" />

    <!--   Header     -->
    <include
        android:id="@+id/header_include"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/component_header" />

    <LinearLayout
        app:layout_constraintTop_toBottomOf="@id/header_include"
        android:paddingTop="80dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/tvSettingsBox"
            layout="@layout/cm_setting"/>
    </LinearLayout>

<!--    <ScrollView-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        app:layout_constraintRight_toRightOf="parent"-->
<!--        app:layout_constraintLeft_toLeftOf="parent"-->
<!--        app:layout_constraintHeight_percent="0.85"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="0dp">-->
<!--    </ScrollView>-->


    <!--   Bottom nav    -->
    <include
        layout="@layout/cm_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />
</androidx.constraintlayout.widget.ConstraintLayout>